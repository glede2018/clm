page {
  --page: #fbf5ee;
  --surface: #ffffff;
  --surface-soft: #fceae0;
  --text: #302522;
  --muted: #77635c;
  --line: #ead8cf;
  --green: #df654b;
  --green-dark: #b94733;
  --coral: #c95762;
  --yellow: #e5a23f;
  --shadow-soft: 0 14rpx 38rpx rgba(100, 61, 46, .09);
  min-height: 100%;
  background: linear-gradient(180deg, #fbf5ee 0%, #fffdfa 55%, #faf2ea 100%);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, picker, scroll-view { box-sizing: border-box; }

.page-shell { padding: 30rpx 28rpx calc(154rpx + env(safe-area-inset-bottom)); animation: page-enter .32s cubic-bezier(.16,1,.3,1) both; }
.surface {
  background: var(--surface);
  border-radius: 24rpx;
  box-shadow: var(--shadow-soft);
}
.section-title { font-size: 32rpx; font-weight: 650; letter-spacing: -.4rpx; }
.section-caption { color: var(--muted); font-size: 24rpx; }
.primary-button {
  background: var(--green-dark);
  color: #fff;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
}
.primary-button:active, .ghost-button:active, button:active { transform: scale(.985); opacity: .88; }
.primary-button::after, .ghost-button::after { border: 0; }
.ghost-button {
  background: var(--surface);
  color: var(--green-dark);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  line-height: 82rpx;
}
.safe-note { color: var(--muted); font-size: 22rpx; line-height: 1.65; }
.pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: var(--green-dark);
  background: var(--surface-soft);
  font-size: 22rpx;
}
@keyframes page-enter { from { opacity: 0; transform: translateY(8rpx); } to { opacity: 1; transform: translateY(0); } }

.intro-layer { position: relative; z-index: 1800; }
.intro-focus { position: fixed; z-index: 1801; border: 4rpx solid #ef8a70; border-radius: 20rpx; box-shadow: 0 0 0 2000rpx rgba(38,29,27,.68), 0 0 0 8rpx rgba(255,255,255,.2); pointer-events: none; animation: intro-focus-in .28s cubic-bezier(.16,1,.3,1) both; }
.intro-tooltip { position: fixed; z-index: 1802; left: 28rpx; right: 28rpx; padding: 24rpx; border: 1rpx solid rgba(255,255,255,.65); border-radius: 24rpx; background: #fffaf7; color: #302522; box-shadow: 0 20rpx 60rpx rgba(45,30,26,.24); animation: intro-tooltip-in .32s cubic-bezier(.16,1,.3,1) both; }
.intro-arrow { position: absolute; left: 44rpx; width: 24rpx; height: 24rpx; background: #fffaf7; transform: rotate(45deg); }
.intro-tooltip-below .intro-arrow { top: -12rpx; border-left: 1rpx solid rgba(255,255,255,.65); border-top: 1rpx solid rgba(255,255,255,.65); }
.intro-tooltip-above .intro-arrow { bottom: -12rpx; }
.intro-meta { display: flex; align-items: center; justify-content: space-between; color: #b94733; font-size: 21rpx; font-weight: 650; }
.intro-skip { padding: 4rpx 0 6rpx 18rpx; color: #806c65; font-weight: 500; }
.intro-title { margin-top: 13rpx; font-size: 32rpx; font-weight: 700; line-height: 1.25; }
.intro-description { margin-top: 9rpx; color: #66534d; font-size: 24rpx; line-height: 1.55; }
.intro-target-hint { margin-top: 15rpx; color: #b94733; font-size: 22rpx; font-weight: 600; }
.intro-next { width: 100%; height: 76rpx; margin: 20rpx 0 0; padding: 0; border-radius: 16rpx; background: #b94733; color: #fff; font-size: 26rpx; font-weight: 650; line-height: 76rpx; }
.intro-next::after { border: 0; }
.intro-next:active { opacity: .9; transform: scale(.985); }
@keyframes intro-focus-in { from { opacity: 0; transform: scale(.96); } to { opacity: 1; transform: scale(1); } }
@keyframes intro-tooltip-in { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) {
  .intro-focus, .intro-tooltip { animation: none; }
}

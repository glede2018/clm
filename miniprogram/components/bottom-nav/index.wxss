.nav-shell { position: fixed; z-index: 1000; left: 0; right: 0; bottom: 0; padding: 0 28rpx calc(14rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: rgba(255,253,250,.98); box-shadow: 0 -8rpx 32rpx rgba(88,52,40,.12); }
.nav-bar { height: 104rpx; display: grid; grid-template-columns: repeat(6, 1fr); }
.nav-item { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3rpx; color: #8b746c; }
.nav-item.active { color: #b94733; }
.nav-item.active::before { content: ''; position: absolute; bottom: 8rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: currentColor; }
.nav-item.active::after { content: ''; position: absolute; top: 12rpx; width: 58rpx; height: 58rpx; border-radius: 50%; background: #fceae0; z-index: -1; }
.nav-icon { position: relative; width: 44rpx; height: 44rpx; color: currentColor; transform-origin: 50% 80%; }
.active .nav-icon { transform: translateY(-2rpx); transition: transform .24s cubic-bezier(.16,1,.3,1); }
.nav-label { font-size: 21rpx; line-height: 28rpx; }
.weight-nav-button { position: relative; width: 58rpx; height: 58rpx; margin-top: -17rpx; display: flex; align-items: center; justify-content: center; border: 5rpx solid #fffdfa; border-radius: 50%; background: linear-gradient(145deg, #d56a50, #b94733); color: #fff; box-shadow: 0 9rpx 24rpx rgba(185,71,51,.28); animation: weight-breathe 2.8s ease-in-out infinite; }
.weight-scale-icon { position: relative; width: 30rpx; height: 25rpx; border: 3rpx solid currentColor; border-radius: 6rpx 6rpx 9rpx 9rpx; }
.weight-scale-icon > view { position: absolute; left: 7rpx; top: 3rpx; width: 11rpx; height: 7rpx; border: 2rpx solid currentColor; border-bottom: 0; border-radius: 8rpx 8rpx 0 0; }
.weight-scale-icon > view::after { content: ''; position: absolute; left: 4rpx; top: 1rpx; width: 2rpx; height: 5rpx; border-radius: 2rpx; background: currentColor; transform: rotate(24deg); transform-origin: bottom; }
.home-bowl { position: absolute; left: 5rpx; bottom: 5rpx; width: 34rpx; height: 18rpx; box-sizing: border-box; border: 4rpx solid currentColor; border-top: 0; border-radius: 4rpx 4rpx 20rpx 20rpx; }
.home-bowl::before { content: ''; position: absolute; left: -3rpx; top: -5rpx; width: 32rpx; height: 4rpx; border-radius: 4rpx; background: currentColor; }
.home-leaf { position: absolute; top: 4rpx; width: 13rpx; height: 9rpx; border: 3rpx solid currentColor; background: transparent; }
.home-leaf-left { left: 9rpx; border-radius: 12rpx 2rpx 12rpx 2rpx; transform: rotate(24deg); }
.home-leaf-right { right: 9rpx; border-radius: 2rpx 12rpx 2rpx 12rpx; transform: rotate(-24deg); }
.icon-training { transform: rotate(-12deg); }
.active .icon-training { transform: rotate(-12deg) translateY(-2rpx); }
.dumbbell-grip { position: absolute; left: 9rpx; top: 19rpx; width: 26rpx; height: 7rpx; border-radius: 5rpx; background: currentColor; }
.dumbbell-plate { position: absolute; top: 10rpx; width: 6rpx; height: 25rpx; border-radius: 5rpx; background: currentColor; }
.plate-left-a { left: 5rpx; }
.plate-left-b { left: 0; height: 19rpx; top: 13rpx; }
.plate-right-a { right: 5rpx; }
.plate-right-b { right: 0; height: 19rpx; top: 13rpx; }
.icon-report { display: flex; align-items: flex-end; justify-content: center; gap: 5rpx; padding-bottom: 5rpx; }
.report-bar { width: 7rpx; border-radius: 7rpx 7rpx 2rpx 2rpx; background: currentColor; }
.bar-short { height: 17rpx; }
.bar-medium { height: 29rpx; }
.bar-tall { height: 38rpx; }
.partner-person::before { content: ''; position: absolute; top: 6rpx; width: 15rpx; height: 15rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.partner-person::after { content: ''; position: absolute; bottom: 5rpx; width: 24rpx; height: 15rpx; border: 3rpx solid currentColor; border-bottom: 0; border-radius: 16rpx 16rpx 0 0; }
.partner-left::before { left: 4rpx; }
.partner-left::after { left: 0; }
.partner-right::before { right: 4rpx; }
.partner-right::after { right: 0; }
.profile-head { position: absolute; top: 4rpx; left: 14rpx; width: 16rpx; height: 16rpx; border: 4rpx solid currentColor; border-radius: 50%; }
.profile-body { position: absolute; left: 5rpx; bottom: 4rpx; width: 34rpx; height: 20rpx; border: 4rpx solid currentColor; border-bottom: 0; border-radius: 22rpx 22rpx 0 0; }
.weight-mask { position: fixed; z-index: 1300; inset: 0; padding: 32rpx; display: flex; align-items: center; justify-content: center; background: rgba(48,37,34,.5); animation: mask-in .2s ease both; }
.weight-sheet { width: 100%; max-width: 620rpx; padding: 28rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 24rpx 70rpx rgba(48,37,34,.22); animation: weight-card-in .42s cubic-bezier(.16,1,.3,1) both; }
.weight-sheet-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 20rpx; color: #302522; }
.weight-sheet-heading > view:first-child { display: flex; flex-direction: column; gap: 6rpx; }
.weight-sheet-heading > view:first-child > text:first-child { font-size: 34rpx; font-weight: 700; }
.weight-sheet-heading > view:first-child > text:last-child { color: #77635c; font-size: 21rpx; }
.sheet-close { position: relative; flex: 0 0 auto; width: 54rpx; height: 54rpx; border-radius: 50%; background: #fbf5ee; }
.sheet-close::before, .sheet-close::after { content: ''; position: absolute; left: 15rpx; top: 25rpx; width: 24rpx; height: 3rpx; border-radius: 4rpx; background: #77635c; transform: rotate(45deg); }
.sheet-close::after { transform: rotate(-45deg); }
.weight-editor { width: 100%; min-height: 112rpx; margin-top: 28rpx; display: grid; grid-template-columns: 84rpx minmax(0, 1fr) 84rpx; align-items: center; gap: 14rpx; }
.weight-step { width: 84rpx; min-width: 84rpx; max-width: 84rpx; height: 84rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; justify-self: center; overflow: hidden; box-sizing: border-box; border: 2rpx solid #cf725d; border-radius: 18rpx; background: #fff0e8; color: #a43f2c; line-height: 1; }
.weight-step::after, .weight-save::after { border: 0; }
.weight-step > text { font-size: 46rpx; font-weight: 700; line-height: 1; }
.weight-step:active { background: #f7ddd2; transform: scale(.96); }
.weight-step[disabled] { opacity: .45; }
.weight-value { width: 100%; min-width: 0; height: 112rpx; padding: 0 16rpx; display: flex; align-items: center; overflow: hidden; border: 1rpx solid #ead8cf; border-radius: 20rpx; background: #fdf9f6; }
.weight-value input { flex: 1 1 0; width: 0; min-width: 0; height: 112rpx; color: #302522; font-size: 48rpx; font-weight: 700; text-align: center; font-variant-numeric: tabular-nums; }
.weight-value > text { flex: 0 0 38rpx; width: 38rpx; color: #77635c; font-size: 23rpx; text-align: right; }
.weight-hint { margin-top: 16rpx; color: #77635c; font-size: 21rpx; line-height: 1.6; }
.weight-save { width: 100%; margin: 26rpx 0 0; border-radius: 18rpx; background: #b94733; color: #fff; font-size: 30rpx; font-weight: 600; line-height: 92rpx; }
@keyframes weight-breathe { 0%,100% { transform: translateY(0) scale(1); box-shadow: 0 9rpx 24rpx rgba(185,71,51,.24); } 50% { transform: translateY(-4rpx) scale(1.035); box-shadow: 0 13rpx 30rpx rgba(185,71,51,.34); } }
@keyframes mask-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes weight-card-in { from { opacity: .2; transform: translateY(8px) scale(.96); } to { opacity: 1; transform: translateY(-50px) scale(1); } }

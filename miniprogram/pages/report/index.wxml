<view class="page-shell report-page">
  <view class="report-header"><view><view class="title">我的报告</view><view class="section-caption">每一次认真执行都算数</view></view><view class="pill">近 7 天</view></view>

  <view class="stat-grid">
    <view class="surface stat"><text>最新体重</text><view><text>{{latestWeight}}</text><text>kg</text></view></view>
    <view class="surface stat"><text>体重变化</text><view><text>{{weightChange}}</text><text>kg</text></view></view>
    <view class="surface stat"><text>饮食执行率</text><view><text>{{executionRate}}</text><text>%</text></view></view>
  </view>

  <view class="surface chart-card">
    <view class="card-heading"><text>近 7 天用餐完成</text><text>{{completedMeals}} 餐</text></view>
    <view class="execution-chart">
      <view wx:for="{{days}}" wx:key="date" class="execution-column">
        <view class="bar-track"><view class="bar-fill" style="height: {{item.barHeight}}%"></view></view>
        <text>{{item.label}}</text><text>{{item.completed}}/{{item.target}}</text>
      </view>
    </view>
  </view>

  <view class="surface chart-card">
    <view class="card-heading"><text>体重趋势</text><text>最近 {{weights.length}} 次</text></view>
    <view wx:if="{{weights.length}}" class="weight-chart">
      <view wx:for="{{weights}}" wx:key="date" class="weight-column">
        <text>{{item.weightKg}}</text><view class="weight-bar" style="height: {{item.barHeight}}rpx"></view><text>{{item.label}}</text>
      </view>
    </view>
    <view wx:else class="empty-chart">记录第一次体重后，这里会出现趋势</view>
  </view>

  <view class="surface weight-entry">
    <view><text class="section-title">记录今天体重</text><text class="section-caption">体重只用于趋势，不改变当天输赢</text></view>
    <view class="weight-input-row"><input type="digit" placeholder="例如 61.8" value="{{weightInput}}" bindinput="onWeightInput" /><text>kg</text><button bindtap="saveWeight">保存</button></view>
  </view>
</view>
<bottom-nav current="report" />

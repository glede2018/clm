.login-page { min-height: 100vh; padding: 116rpx 42rpx 50rpx; text-align: center; background: radial-gradient(circle at 50% 14%, #f8d9c9 0, #fbf5ee 42%, #fffdfa 100%); animation: login-fade .4s ease both; }
.brand-mark { width: 154rpx; height: 142rpx; margin: 0 auto 30rpx; position: relative; animation: mark-arrive .7s cubic-bezier(.16,1,.3,1) both; }
.mark-stem { position: absolute; left: 74rpx; top: 38rpx; width: 7rpx; height: 92rpx; border-radius: 9rpx; background: #8a4b37; transform: rotate(12deg); }
.mark-leaf { position: absolute; width: 58rpx; height: 34rpx; background: #d95d44; }
.leaf-one { left: 20rpx; top: 27rpx; border-radius: 36rpx 5rpx 36rpx 5rpx; transform: rotate(22deg); }
.leaf-two { right: 13rpx; top: 47rpx; border-radius: 5rpx 36rpx 5rpx 36rpx; background: #e7a13d; transform: rotate(-18deg); }
.leaf-three { left: 35rpx; top: 82rpx; width: 48rpx; height: 28rpx; border-radius: 30rpx 5rpx 30rpx 5rpx; background: #bf584b; transform: rotate(33deg); }
.title { font-size: 52rpx; font-weight: 800; letter-spacing: 1rpx; }
.subtitle { margin-top: 12rpx; color: var(--muted); }
.login-card { margin-top: 64rpx; padding: 38rpx 32rpx 34rpx; text-align: left; }
.login-title { font-size: 33rpx; font-weight: 650; }
.login-caption { margin: 12rpx auto 0; max-width: 500rpx; color: var(--muted); font-size: 23rpx; line-height: 1.6; }
.login-button { margin-top: 34rpx; background: linear-gradient(135deg, #f58a67, #d95d44); }
.privacy-note { margin: 28rpx auto 0; max-width: 600rpx; color: var(--muted); font-size: 21rpx; line-height: 1.6; }
@keyframes login-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes mark-arrive { from { opacity: 0; transform: translateY(18rpx) rotate(-5deg); } to { opacity: 1; transform: translateY(0) rotate(0); } }

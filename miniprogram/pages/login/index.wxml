<view class="login-page">
  <view class="brand-mark">
    <view class="mark-stem"></view>
    <view class="mark-leaf leaf-one"></view>
    <view class="mark-leaf leaf-two"></view>
    <view class="mark-leaf leaf-three"></view>
  </view>
  <view class="title">食克有数</view>
  <view class="subtitle">把每一餐，慢慢拉回自己这边</view>

  <view class="surface login-card">
    <view class="login-title">使用微信身份登录</view>
    <view class="login-caption">无需填写用户名和头像，登录后直接建立你的个人方案</view>
    <button class="primary-button login-button" loading="{{loading}}" disabled="{{loading}}" bindtap="login">微信授权登录</button>
  </view>
  <view class="privacy-note">登录后将使用微信提供的用户标识保存你的健康设置和餐食记录。</view>
</view>

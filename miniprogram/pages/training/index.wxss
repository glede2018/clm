.training-page { padding-top: 22rpx; }
.training-header { display: flex; align-items: center; justify-content: space-between; margin: 4rpx 2rpx 24rpx; }
.title { font-size: 42rpx; font-weight: 700; margin-bottom: 7rpx; }
.training-stat { min-width: 100rpx; padding: 11rpx 14rpx; border-radius: 20rpx; text-align: center; background: var(--surface-soft); color: var(--green-dark); }
.training-stat text { display: block; }
.training-stat text:first-child { font-size: 30rpx; font-weight: 700; }
.training-stat text:last-child { font-size: 19rpx; }
.step-indicator { width: 390rpx; margin: 0 auto 23rpx; display: flex; align-items: flex-start; justify-content: center; margin-bottom: 16rpx; }
.step-node { position: relative; z-index: 2; width: 118rpx; display: flex; flex-direction: column; align-items: center; gap: 7rpx; color: var(--muted); font-size: 20rpx; }
.step-node > view { width: 43rpx; height: 43rpx; border: 2rpx solid var(--surface-soft); border-radius: 50%; line-height: 39rpx; text-align: center; color: var(--muted); background: var(--surface); font-size: 21rpx; font-weight: 700; transition: all .25s ease; }
.step-node.active { color: var(--green-dark); }
.step-node.active > view { border-color: var(--green-dark); color: var(--surface); background: var(--green-dark); box-shadow: 0 5rpx 13rpx rgba(217,93,68,.22); }
.step-line { width: 112rpx; height: 4rpx; margin: 20rpx -18rpx 0; background: var(--surface-soft); transition: background .25s ease; }
.step-line.active { background: var(--green-dark); }
.step-panel { animation: none; }
.anatomy-card { padding: 12rpx 18rpx; overflow: hidden; background: var(--surface); }
.anatomy-card-heading { padding: 8rpx 7rpx 0; display: flex; align-items: center; justify-content: space-between; }
.anatomy-card-heading > text:first-child { color: var(--text); font-size: 26rpx; font-weight: 600; }
.anatomy-card-heading > text:last-child { color: var(--muted); font-size: 20rpx; }
.anatomy-stage { position: relative; width: 508rpx; height: 440rpx; animation: none; max-width: 100%; margin: 0 auto; }
.anatomy-image { position: absolute; z-index: 1; left: 0; top: 0; width: 100%; height: 425rpx; }
.muscle-layer { z-index: 2; animation: muscle-light .26s ease both; }
.muscle-hitbox { position: absolute; z-index: 4; background: transparent; }
.muscle-hitbox:active { border-radius: 24rpx; background: rgba(232,111,81,.12); }
.figure-label { position: absolute; z-index: 5; bottom: 0; padding: 6rpx 15rpx; border-radius: 999rpx; color: var(--muted); background: var(--line); font-size: 20rpx; }
.front-label { left: 17%; }
.back-label { right: 16%; }
.selected-muscles { min-height: 54rpx; display: flex; flex-wrap: wrap; justify-content: flex-start; gap: 8rpx; max-height: 108rpx; overflow-y: auto; }
.selected-muscle { padding: 10rpx 14rpx; border-radius: 999rpx; color: var(--green-dark); background: var(--surface-soft); font-size: 22rpx; }
.selected-muscle text { margin-left: 5rpx; color: var(--green-dark); }
.empty-selection { color: var(--muted); font-size: 23rpx; line-height: 58rpx; }
.next-action-wrap { margin-top: 16rpx; display: flex; justify-content: center; }
.next-button { width: 100%; min-width: 0; max-width: 100%; height: 84rpx; margin: 0; padding: 0 34rpx; display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; line-height: 84rpx; white-space: nowrap; }
.next-button.disabled { opacity: .55; }
.selected-summary { padding: 12rpx 18rpx; border: 1rpx solid var(--surface-soft); border-radius: 21rpx; background: var(--surface); }
.selected-summary > text { color: var(--muted); font-size: 21rpx; }
.selected-summary > view { margin-top: 6rpx; display: flex; flex-wrap: wrap; gap: 9rpx; max-height: 96rpx; overflow-y: auto; }
.selected-summary > view text { padding: 7rpx 13rpx; border-radius: 999rpx; color: var(--green-dark); background: var(--surface-soft); font-size: 21rpx; }
.equipment-section { margin-top: 18rpx; }
.section-block { margin-top: 18rpx; }
.section-heading { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 15rpx; }
.section-heading text:first-child { font-size: 30rpx; font-weight: 600; }
.section-heading text:last-child { color: var(--muted); font-size: 21rpx; }
.equipment-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; }
.equipment-choice { position: relative; min-width: 0; height: 140rpx; padding: 8rpx; display: flex; flex-direction: column; align-items: center; justify-content: space-between; border: 2rpx solid var(--surface-soft); border-radius: 16rpx; background: var(--surface); color: var(--muted); transition: all .22s ease; }
.equipment-choice:active { transform: scale(.96); }
.equipment-choice.selected { color: var(--green-dark); border-color: var(--green-dark); background: var(--surface-soft); transform: translateY(-2rpx); }
.equipment-image-wrap { position: relative; width: 100%; height: 84rpx; display: flex; align-items: center; justify-content: center; }
.equipment-image { width: 94rpx; height: 80rpx; transition: transform .22s ease, filter .22s ease; }
.equipment-choice.selected .equipment-image { transform: scale(1.07); filter: drop-shadow(0 5rpx 7rpx rgba(217,93,68,.2)); }
.equipment-check { position: absolute; top: -5rpx; right: 0; width: 31rpx; height: 31rpx; border: 3rpx solid var(--surface); border-radius: 50%; line-height: 28rpx; text-align: center; color: var(--surface); background: var(--green-dark); font-size: 18rpx; font-weight: 700; animation: equipment-check-in .25s cubic-bezier(.16,1,.3,1) both; }
.equipment-name { max-width: 100%; overflow: hidden; font-size: 21rpx; font-weight: 600; line-height: 29rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.duration-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 11rpx; }
.duration-choice { padding: 10rpx 4rpx; border: 1rpx solid var(--surface-soft); border-radius: 16rpx; text-align: center; background: var(--surface); color: var(--muted); }
.duration-choice text { display: block; }
.duration-choice text:first-child { color: var(--text); font-size: 30rpx; font-weight: 700; }
.duration-choice text:last-child { font-size: 19rpx; }
.duration-choice.selected { border-color: var(--green-dark); background: var(--surface-soft); }
.duration-choice.selected text:first-child { color: var(--green-dark); }
.match-preview { margin-top: 14rpx; color: var(--muted); font-size: 22rpx; text-align: center; }
.match-preview text { color: var(--green-dark); font-size: 27rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.step-actions { margin-top: 16rpx; display: flex; align-items: center; justify-content: center; gap: 14rpx; }
.step-actions button { width: fit-content; max-width: 100%; height: 84rpx; margin: 0; padding: 0 34rpx; display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; line-height: 84rpx; white-space: nowrap; }
.previous-button { min-width: 154rpx; }
.generate-workout { min-width: 224rpx; }
.media-note { padding: 18rpx 0 4rpx; text-align: center; color: var(--muted); font-size: 20rpx; }
@keyframes anatomy-enter { from { opacity: .2; transform: scale(.96); } to { opacity: 1; transform: scale(1); } }
@keyframes muscle-light { from { opacity: 0; transform: scale(.985); } to { opacity: 1; transform: scale(1); } }
@keyframes equipment-check-in { from { opacity: 0; transform: scale(.7); } to { opacity: 1; transform: scale(1); } }
@keyframes step-enter { from { opacity: 0; transform: translateX(16rpx); } to { opacity: 1; transform: translateX(0); } }

.step-actions .generate-workout { flex: 1; }

.step-node.active > view, .equipment-check { color: var(--on-accent); background: var(--green-dark); box-shadow: none; }

@media (max-height: 640px) {
 .anatomy-stage { width: 433rpx; height: 375rpx; }
 .anatomy-image { height: 362rpx; }
 .equipment-choice { height: 124rpx; }
 .equipment-image-wrap { height: 68rpx; }
 .equipment-image { height: 66rpx; }
}

.step-node.active > view, .equipment-check { color: var(--on-accent); }

.training-page { padding-top: 22rpx; }
.training-header { display: flex; align-items: center; justify-content: space-between; margin: 4rpx 2rpx 24rpx; }
.title { font-size: 42rpx; font-weight: 700; margin-bottom: 7rpx; }
.training-stat { min-width: 100rpx; padding: 11rpx 14rpx; border-radius: 20rpx; text-align: center; background: #fff0e8; color: #d95d44; }
.training-stat text { display: block; }
.training-stat text:first-child { font-size: 30rpx; font-weight: 700; }
.training-stat text:last-child { font-size: 19rpx; }
.step-indicator { width: 390rpx; margin: 0 auto 23rpx; display: flex; align-items: flex-start; justify-content: center; }
.step-node { position: relative; z-index: 2; width: 118rpx; display: flex; flex-direction: column; align-items: center; gap: 7rpx; color: #a38d85; font-size: 20rpx; }
.step-node > view { width: 43rpx; height: 43rpx; border: 2rpx solid #dfc9c0; border-radius: 50%; line-height: 39rpx; text-align: center; color: #a38d85; background: #fffaf7; font-size: 21rpx; font-weight: 700; transition: all .25s ease; }
.step-node.active { color: #d95d44; }
.step-node.active > view { border-color: #e86f51; color: #fff; background: #e86f51; box-shadow: 0 5rpx 13rpx rgba(217,93,68,.22); }
.step-line { width: 112rpx; height: 4rpx; margin: 20rpx -18rpx 0; background: #ead8d0; transition: background .25s ease; }
.step-line.active { background: #e86f51; }
.step-panel { animation: step-enter .32s cubic-bezier(.16,1,.3,1) both; }
.anatomy-card { padding: 14rpx 18rpx 22rpx; overflow: hidden; background: #fffdfb; }
.anatomy-card-heading { padding: 8rpx 7rpx 0; display: flex; align-items: center; justify-content: space-between; }
.anatomy-card-heading > text:first-child { color: #5d4841; font-size: 26rpx; font-weight: 600; }
.anatomy-card-heading > text:last-child { color: #9a827a; font-size: 20rpx; }
.anatomy-stage { position: relative; width: 100%; height: 570rpx; animation: anatomy-enter .4s ease both; }
.anatomy-image { position: absolute; z-index: 1; left: 0; top: 0; width: 100%; height: 550rpx; }
.muscle-layer { z-index: 2; animation: muscle-light .26s ease both; }
.muscle-hitbox { position: absolute; z-index: 4; background: transparent; }
.muscle-hitbox:active { border-radius: 24rpx; background: rgba(232,111,81,.12); }
.figure-label { position: absolute; z-index: 5; bottom: 0; padding: 6rpx 15rpx; border-radius: 999rpx; color: #8f7a72; background: #f8eee9; font-size: 20rpx; }
.front-label { left: 17%; }
.back-label { right: 16%; }
.selected-muscles { min-height: 58rpx; display: flex; flex-wrap: wrap; justify-content: center; gap: 10rpx; }
.selected-muscle { padding: 10rpx 16rpx; border-radius: 999rpx; color: #c9543c; background: #fff0e8; font-size: 23rpx; }
.selected-muscle text { margin-left: 5rpx; color: #a77f72; }
.empty-selection { color: #9a827a; font-size: 23rpx; line-height: 58rpx; }
.next-action-wrap { margin-top: 24rpx; display: flex; justify-content: center; }
.next-button { width: fit-content; min-width: 390rpx; max-width: 100%; height: 88rpx; margin: 0; padding: 0 34rpx; display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; line-height: 88rpx; white-space: nowrap; }
.next-button.disabled { opacity: .55; }
.selected-summary { padding: 20rpx 22rpx; border: 1rpx solid #f0ded5; border-radius: 21rpx; background: #fff; }
.selected-summary > text { color: #8f7a72; font-size: 21rpx; }
.selected-summary > view { margin-top: 11rpx; display: flex; flex-wrap: wrap; gap: 9rpx; }
.selected-summary > view text { padding: 7rpx 13rpx; border-radius: 999rpx; color: #c9543c; background: #fff0e8; font-size: 21rpx; }
.equipment-section { margin-top: 25rpx; }
.section-block { margin-top: 30rpx; }
.section-heading { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 15rpx; }
.section-heading text:first-child { font-size: 30rpx; font-weight: 600; }
.section-heading text:last-child { color: #9a827a; font-size: 21rpx; }
.equipment-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; }
.equipment-choice { position: relative; min-width: 0; height: 178rpx; padding: 12rpx 8rpx 13rpx; display: flex; flex-direction: column; align-items: center; justify-content: space-between; border: 2rpx solid #f0ded5; border-radius: 20rpx; background: #fff; color: #765f57; transition: all .22s ease; }
.equipment-choice:active { transform: scale(.96); }
.equipment-choice.selected { color: #b94733; border-color: #d96c52; background: #fceae0; transform: translateY(-2rpx); }
.equipment-image-wrap { position: relative; width: 100%; height: 108rpx; display: flex; align-items: center; justify-content: center; }
.equipment-image { width: 112rpx; height: 98rpx; transition: transform .22s ease, filter .22s ease; }
.equipment-choice.selected .equipment-image { transform: scale(1.07); filter: drop-shadow(0 5rpx 7rpx rgba(217,93,68,.2)); }
.equipment-check { position: absolute; top: -5rpx; right: 0; width: 31rpx; height: 31rpx; border: 3rpx solid #fff; border-radius: 50%; line-height: 28rpx; text-align: center; color: #fff; background: #d95d44; font-size: 18rpx; font-weight: 700; animation: equipment-check-in .25s cubic-bezier(.16,1,.3,1) both; }
.equipment-name { max-width: 100%; overflow: hidden; font-size: 21rpx; font-weight: 600; line-height: 29rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.duration-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 11rpx; }
.duration-choice { padding: 18rpx 4rpx; border: 1rpx solid #f0ded5; border-radius: 18rpx; text-align: center; background: #fff; color: #8a7770; }
.duration-choice text { display: block; }
.duration-choice text:first-child { color: #4c3933; font-size: 30rpx; font-weight: 700; }
.duration-choice text:last-child { font-size: 19rpx; }
.duration-choice.selected { border-color: #d96c52; background: #fceae0; }
.duration-choice.selected text:first-child { color: #d95d44; }
.match-preview { margin-top: 26rpx; color: #8f7a72; font-size: 22rpx; text-align: center; }
.match-preview text { color: #c9543c; font-size: 27rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.step-actions { margin-top: 34rpx; display: flex; align-items: center; justify-content: center; gap: 14rpx; }
.step-actions button { width: fit-content; max-width: 100%; height: 88rpx; margin: 0; padding: 0 34rpx; display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; line-height: 88rpx; white-space: nowrap; }
.previous-button { min-width: 154rpx; }
.generate-workout { min-width: 224rpx; }
.media-note { padding: 18rpx 0 4rpx; text-align: center; color: #a18a82; font-size: 20rpx; }
@keyframes anatomy-enter { from { opacity: .2; transform: scale(.96); } to { opacity: 1; transform: scale(1); } }
@keyframes muscle-light { from { opacity: 0; transform: scale(.985); } to { opacity: 1; transform: scale(1); } }
@keyframes equipment-check-in { from { opacity: 0; transform: scale(.7); } to { opacity: 1; transform: scale(1); } }
@keyframes step-enter { from { opacity: 0; transform: translateX(16rpx); } to { opacity: 1; transform: translateX(0); } }

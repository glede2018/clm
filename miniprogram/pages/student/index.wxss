.loading-state, .error-state { margin-top: 100rpx; padding: 60rpx 25rpx; text-align: center; color: var(--muted); }
.student-header { display: flex; align-items: center; gap: 16rpx; margin: 0 0 12rpx; }
.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--green); color: var(--on-accent); display: grid; place-items: center; font-size: 30rpx; }
.title { font-size: 40rpx; font-weight: 700; margin-bottom: 7rpx; }
.today-heading { display: flex; justify-content: space-between; align-items: center; margin: 14rpx 0 12rpx; }
.today-heading text:first-child { font-size: 30rpx; font-weight: 600; }
.today-heading text:last-child { color: var(--muted); font-size: 22rpx; }
.meal-records { display: flex; flex-direction: column; gap: 14rpx; }
.meal-record { padding: 18rpx; border: 1rpx solid var(--line); box-shadow: none; margin-bottom: 12rpx; }
.record-heading { display: flex; justify-content: space-between; }
.record-heading text:first-child { font-weight: 600; }
.record-heading text:last-child { color: var(--green-dark); font-size: 22rpx; }
.portion-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.portion-tags text { padding: 9rpx 13rpx; border-radius: 12rpx; background: var(--page); font-size: 22rpx; }
.record-macros { display: flex; gap: 18rpx; margin-top: 17rpx; color: var(--muted); font-size: 20rpx; }
.empty-state { padding: 32rpx 16rpx; text-align: center; color: var(--muted); font-size: 24rpx; }
.weight-card { padding: 16rpx 18rpx; }
.weight-chart { height: 170rpx; display: flex; align-items: flex-end; justify-content: space-around; gap: 7rpx; }
.weight-column { height: 100%; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; color: var(--muted); font-size: 17rpx; }
.weight-column text:first-child { color: var(--text); margin-bottom: 5rpx; }
.weight-column view { width: 27rpx; min-height: 18rpx; border-radius: 99rpx 99rpx 5rpx 5rpx; background: var(--coral); opacity: .78; }
.weight-column text:last-child { margin-top: 6rpx; }

.student-header .title { overflow-wrap: anywhere; }

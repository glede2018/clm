.setup-page { min-height: 100vh; padding: 42rpx 34rpx calc(42rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; }
.progress-head { display: flex; justify-content: space-between; color: var(--muted); font-size: 23rpx; }
.progress-track { height: 10rpx; margin-top: 18rpx; overflow: hidden; border-radius: 10rpx; background: #f3ded3; }
.progress-fill { height: 100%; border-radius: inherit; background: var(--green); transition: width .35s cubic-bezier(.16,1,.3,1); }
.step-content { flex: 1; padding-top: 52rpx; }
.step-title { font-size: 52rpx; font-weight: 750; }
.step-intro { margin-top: 12rpx; color: var(--muted); font-size: 23rpx; }
.body-form { margin-top: 38rpx; padding: 8rpx 28rpx; }
.compact-field, .gender-field { min-height: 104rpx; display: flex; align-items: center; justify-content: flex-start; gap: 14rpx; border-bottom: 1rpx solid var(--line); }
.compact-field > text, .gender-field > text { flex: 0 0 126rpx; width: 126rpx; color: var(--muted); }
.compact-value { flex: 1; min-width: 0; display: flex; align-items: baseline; justify-content: flex-start; gap: 8rpx; }
.number-editor { width: 130rpx; min-width: 0; height: 62rpx; padding: 0; border: 0; background: transparent; color: var(--text); font-size: 32rpx; font-weight: 700; text-align: left; }
.compact-value text:last-child { color: var(--muted); font-size: 24rpx; }
.stepper { flex: 0 0 auto; display: flex; gap: 10rpx; }
.stepper-button { width: 66rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid var(--line); border-radius: 17rpx; background: var(--surface); color: var(--green-dark); font-size: 36rpx; font-weight: 500; line-height: 1; }
.stepper-button.plus { border-color: var(--green); background: var(--surface-soft); box-shadow: 0 5rpx 12rpx rgba(217,93,68,.1); }
.gender-options { min-width: 0; display: flex; gap: 12rpx; }
.gender-option { flex: 0 0 108rpx; width: 108rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: var(--page); color: var(--muted); font-size: 26rpx; }
.gender-option.active { background: var(--green); color: #fff; }
.form-hint { padding: 24rpx 0; color: var(--muted); font-size: 22rpx; line-height: 1.6; }
.hint { width: 100%; margin-top: 26rpx; text-align: center; color: var(--muted); font-size: 23rpx; }
.large-options { display: grid; gap: 16rpx; }
.two-columns { grid-template-columns: 1fr 1fr; }
.option { margin: 0; min-height: 180rpx; padding: 28rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 10rpx; color: var(--text); font-size: 31rpx; }
.option::after { border: 0; }
.option { box-shadow: none; border: 1rpx solid var(--line); }
.option.active { border-color: var(--green); background: var(--surface-soft); transform: translateY(-2rpx); }
.option-icon { font-size: 76rpx; }
.habit-form { margin-top: 34rpx; }
.group-label { margin-bottom: 16rpx; font-size: 28rpx; font-weight: 650; }
.exercise-options { grid-template-columns: 1fr 1fr; }
.exercise { min-height: 142rpx; align-items: flex-start; font-size: 27rpx; }
.option-caption { color: var(--muted); font-size: 23rpx; }
.meal-option { min-height: 150rpx; align-items: flex-start; }
.meals-label { margin-top: 34rpx; }
.meal-options { grid-template-columns: 1fr 1fr; }
.source-note { display: flex; align-items: flex-start; gap: 10rpx; color: var(--muted); font-size: 21rpx; line-height: 1.55; }
.compact-source-note { margin: 22rpx 4rpx 0; }
.source-note-icon { flex: 0 0 28rpx; width: 28rpx; height: 28rpx; margin-top: 2rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--line); border-radius: 50%; color: var(--green-dark); font-size: 18rpx; font-weight: 700; line-height: 1; }
.actions { display: flex; gap: 18rpx; }
.actions button { margin: 0; }
.back { width: 190rpx; }
.next { flex: 1; }

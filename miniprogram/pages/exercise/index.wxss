.media-card { position: relative; overflow: hidden; padding: 12rpx; }
.exercise-gif { display: block; width: 100%; height: 470rpx; border-radius: 21rpx; background: #f8eeea; }
.gif-badge { position: absolute; left: 28rpx; bottom: 28rpx; padding: 8rpx 13rpx; border-radius: 999rpx; color: #fff; background: rgba(74,48,41,.72); font-size: 19rpx; }
.exercise-title { margin-top: 28rpx; font-size: 38rpx; font-weight: 700; line-height: 1.3; }
.tag-row { margin-top: 15rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.tag { padding: 9rpx 14rpx; border-radius: 999rpx; color: #7f675f; background: #fff; border: 1rpx solid #ead9d1; font-size: 21rpx; }
.muscle-tag { color: #c9543c; border-color: #efb29f; background: #fff0e8; }
.instruction-card { margin-top: 25rpx; padding: 27rpx 24rpx; }
.instruction-list { margin-top: 21rpx; display: flex; flex-direction: column; gap: 22rpx; }
.instruction-row { display: flex; align-items: flex-start; gap: 16rpx; color: #5f4b44; line-height: 1.65; }
.step-number { flex: 0 0 42rpx; width: 42rpx; height: 42rpx; border-radius: 50%; line-height: 42rpx; text-align: center; color: #fff; background: linear-gradient(135deg,#f5a05f,#df654b); font-size: 21rpx; font-weight: 700; }
.instruction-row text { flex: 1; font-size: 25rpx; }
.safety-card { margin-top: 20rpx; padding: 22rpx; border-radius: 20rpx; background: #fff0df; color: #775c45; }
.safety-card text { display: block; }
.safety-card text:first-child { margin-bottom: 7rpx; font-weight: 600; }
.safety-card text:last-child { font-size: 22rpx; line-height: 1.6; }
.attribution { padding: 23rpx 0 4rpx; text-align: center; color: #9e8880; font-size: 19rpx; }

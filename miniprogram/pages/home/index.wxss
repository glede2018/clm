.home-page { overflow: hidden; }
.home-header { display: flex; justify-content: space-between; align-items: center; margin: 4rpx 2rpx 22rpx; }
.greeting { font-size: 40rpx; font-weight: 700; margin-bottom: 5rpx; }
.today-badge { padding: 10rpx 18rpx; border-radius: 999rpx; background: var(--surface-soft); color: var(--green-dark); font-size: 22rpx; }
.tug-card { padding: 22rpx 24rpx; }
.tug-heading { display: flex; justify-content: space-between; color: var(--muted); font-size: 23rpx; }
.rope-row { display: grid; grid-template-columns: 78rpx 1fr 64rpx; gap: 8rpx; align-items: center; margin-top: 10rpx; }
.rope-side { display: flex; flex-direction: column; align-items: center; font-size: 19rpx; color: var(--muted); }
.rope-side text:first-child { font-size: 38rpx; }
.rope { height: 14rpx; border-radius: 999rpx; position: relative; background: linear-gradient(90deg, var(--coral), var(--yellow) 50%, var(--green)); }
.rope-knot { position: absolute; top: 50%; width: 38rpx; height: 38rpx; border: 8rpx solid var(--green); border-radius: 50%; background: var(--surface); transform: translate(-50%, -50%); transition: left .65s cubic-bezier(.2,.8,.2,1); box-shadow: 0 4rpx 16rpx rgba(217,93,68,.28); animation: knot-pulse 1.8s ease-in-out infinite; }
.game-stage { min-height: 540rpx; display: grid; grid-template-columns: 1.05fr .95fr; gap: 14rpx; align-items: center; }
.avatar-zone { height: 500rpx; display: flex; align-items: flex-end; justify-content: center; position: relative; }
.avatar-scale { width: 280rpx; height: 420rpx; transform-origin: 50% 100%; transition: transform .45s ease; z-index: 2; }
.avatar-image { display: block; width: 100%; height: 100%; transform-origin: 50% 100%; animation: avatar-breathe 5.2s cubic-bezier(.4,0,.2,1) infinite; }
.ground-shadow { position: absolute; bottom: 1rpx; width: 174rpx; height: 22rpx; border-radius: 50%; background: rgba(65,76,61,.12); animation: shadow-breathe 5.2s cubic-bezier(.4,0,.2,1) infinite; }
.motion-halo { position: absolute; left: 50%; bottom: 48rpx; z-index: 1; width: 210rpx; height: 210rpx; border: 2rpx solid rgba(244,124,92,.26); border-radius: 50%; opacity: 0; transform: translateX(-50%) scale(.72); }
.speech { position: absolute; top: 25rpx; left: 50%; z-index: 8; width: 220rpx; padding: 12rpx 18rpx; border: 1rpx solid rgba(244,124,92,.18); border-radius: 999rpx; background: rgba(255,250,246,.96); box-shadow: 0 8rpx 22rpx rgba(176,91,65,.09); color: var(--text); font-size: 21rpx; text-align: center; transform: translateX(-50%); animation: status-fade 1.45s ease both; }
.celebrating .avatar-image { animation: avatar-acknowledge 1.35s cubic-bezier(.22,.75,.25,1) both; }
.celebrating .motion-halo { animation: halo-expand 1.35s ease-out both; }
.meal-list { display: flex; flex-direction: column; gap: 14rpx; }
.meal-button { margin: 0; padding: 17rpx 14rpx; min-height: 116rpx; border-radius: 24rpx; border: 1rpx solid var(--line); background: var(--surface); color: var(--text); display: grid; grid-template-columns: 50rpx 1fr 28rpx; gap: 10rpx; align-items: center; text-align: left; box-shadow: 0 8rpx 22rpx rgba(176,91,65,.07); animation: meal-slide .42s cubic-bezier(.2,.8,.2,1) both; }
.meal-button:nth-child(2) { animation-delay: .07s; }
.meal-button:nth-child(3) { animation-delay: .14s; }
.meal-button::after { border: 0; }
.meal-button.done { background: linear-gradient(135deg, #fff8f3, #fff0e8); border-color: #f2a58e; box-shadow: 0 9rpx 24rpx rgba(217,93,68,.14), inset 5rpx 0 0 #f47c5c; animation: meal-done-pop .35s ease both; }
.meal-button.disabled { opacity: .46; }
.meal-icon { font-size: 40rpx; }
.meal-content { min-width: 0; }
.meal-button .strong { display: block; font-size: 27rpx; font-weight: 600; }
.done .strong { color: var(--text); }
.meal-caption { display: block; margin-top: 4rpx; color: var(--muted); font-size: 19rpx; line-height: 1.45; white-space: normal; overflow-wrap: break-word; }
.meal-foods { display: flex; flex-wrap: wrap; gap: 7rpx; margin-top: 8rpx; }
.meal-food { padding: 5rpx 11rpx; border: 1rpx solid #e96d4e; border-radius: 999rpx; background: #f47c5c; color: #fff; font-size: 19rpx; font-weight: 600; line-height: 1.3; box-shadow: 0 4rpx 10rpx rgba(217,93,68,.2); animation: food-highlight .38s cubic-bezier(.2,.8,.2,1) both; }
.meal-check { width: 28rpx; height: 28rpx; border-radius: 50%; color: var(--green); text-align: center; line-height: 28rpx; }
.done .meal-check { background: var(--green); color: #fff; box-shadow: 0 0 0 7rpx rgba(244,124,92,.12); }
.nutrition-strip { display: grid; grid-template-columns: repeat(4, 1fr); padding: 20rpx 10rpx; }
.nutrition-strip view { display: flex; flex-direction: column; align-items: center; border-right: 1rpx solid var(--line); color: var(--muted); font-size: 20rpx; }
.nutrition-strip view:last-child { border-right: 0; }
.nutrition-strip .strong { margin-top: 5rpx; color: var(--text); font-size: 25rpx; font-weight: 600; }
.raw-note { margin-top: 18rpx; text-align: center; color: var(--muted); font-size: 21rpx; }
@keyframes avatar-breathe { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-3rpx); } }
@keyframes shadow-breathe { 0%,100% { opacity: .8; transform: scaleX(1); } 50% { opacity: .58; transform: scaleX(.94); } }
@keyframes avatar-acknowledge { 0%,100% { transform: translateY(0); } 42% { transform: translateY(-9rpx); } 68% { transform: translateY(-5rpx); } }
@keyframes halo-expand { 0% { opacity: 0; transform: translateX(-50%) scale(.72); } 35% { opacity: .7; } 100% { opacity: 0; transform: translateX(-50%) scale(1.18); } }
@keyframes status-fade { 0% { opacity: 0; transform: translate(-50%, 7rpx); } 18%,75% { opacity: 1; transform: translate(-50%, 0); } 100% { opacity: 0; transform: translate(-50%, -4rpx); } }
@keyframes knot-pulse { 0%,100% { box-shadow: 0 4rpx 14rpx rgba(217,93,68,.2); } 50% { box-shadow: 0 4rpx 24rpx rgba(217,93,68,.42); } }
@keyframes meal-done-pop { from { transform: scale(.96); } to { transform: scale(1); } }
@keyframes meal-slide { from { opacity: 0; transform: translateX(25rpx); } to { opacity: 1; transform: translateX(0); } }
@keyframes food-highlight { from { opacity: 0; transform: translateY(6rpx) scale(.92); } to { opacity: 1; transform: translateY(0) scale(1); } }

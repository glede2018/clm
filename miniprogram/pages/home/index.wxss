.home-page { padding-left: 28rpx; padding-right: 28rpx; }
.home-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 18rpx; margin: 4rpx 2rpx 24rpx; }
.greeting { font-size: 40rpx; font-weight: 700; margin-bottom: 5rpx; }
.today-badge { flex: 0 0 auto; padding: 10rpx 17rpx; border-radius: 999rpx; background: #fff0cf; color: #8a5718; font-size: 22rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.guest-entry { margin: -4rpx 0 20rpx; padding: 18rpx 20rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border: 1rpx solid #edcfc2; border-radius: 20rpx; background: #fff8f3; }
.guest-entry > view { min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.guest-entry > view > text:first-child { font-size: 25rpx; font-weight: 700; }
.guest-entry > view > text:last-child { color: var(--muted); font-size: 20rpx; }
.guest-entry > button { flex: 0 0 150rpx; width: 150rpx; height: 62rpx; margin: 0; padding: 0; border-radius: 15rpx; background: #b94733; color: #fff; font-size: 23rpx; font-weight: 650; line-height: 62rpx; }
.guest-entry > button::after { border: 0; }
.intake-table { overflow: hidden; padding: 0 20rpx 20rpx; border: 1rpx solid #e8d7ce; box-shadow: 0 16rpx 38rpx rgba(73,53,47,.11); }
.intake-heading { display: flex; justify-content: space-between; align-items: center; margin: 0 -20rpx 12rpx; padding: 22rpx 24rpx; background: #49352f; color: #fffaf7; }
.intake-heading > text:first-child { font-size: 31rpx; font-weight: 650; }
.intake-heading > text:last-child { color: #ffd7c8; font-size: 21rpx; }
.table-row { min-height: 69rpx; display: grid; grid-template-columns: 120rpx repeat(4, 1fr); align-items: center; border-top: 1rpx solid var(--line); }
.table-row > text:first-child { padding-left: 4rpx; color: var(--muted); font-size: 21rpx; }
.table-row > text:not(:first-child), .table-row > view { min-width: 0; text-align: center; }
.table-header { min-height: 44rpx; border-top: 0; color: var(--muted); font-size: 19rpx; font-weight: 600; }
.table-row > view { display: flex; align-items: baseline; justify-content: center; gap: 2rpx; font-variant-numeric: tabular-nums; }
.table-row > view > text:first-child { color: var(--text); font-size: 24rpx; font-weight: 650; }
.table-row > view > text:last-child { color: var(--muted); font-size: 16rpx; }
.macro-carbs { color: #9a651f; }
.macro-protein { color: #b64f43; }
.macro-fat { color: #765779; }
.macro-calories { color: #476c67; }
.table-row > view.macro-carbs > text:first-child { color: #805116; }
.table-row > view.macro-protein > text:first-child { color: #a23e34; }
.table-row > view.macro-fat > text:first-child { color: #66496a; }
.table-row > view.macro-calories > text:first-child { color: #365c57; }
.consumed-row { background: #fff3ed; border-radius: 13rpx; }
.consumed-row > text:first-child { color: #a44535; font-weight: 600; }
.intake-progress { height: 8rpx; margin: 17rpx 4rpx 0; overflow: hidden; border-radius: 99rpx; background: #efe2da; }
.intake-progress > view { width: 100%; height: 100%; border-radius: inherit; background: #d85f48; transform-origin: left center; transition: transform .55s cubic-bezier(.16,1,.3,1); }
.guest-table-note { margin: 15rpx 4rpx 0; color: var(--muted); font-size: 20rpx; text-align: center; }
.meal-feedback { position: fixed; z-index: 1100; top: calc(28rpx + env(safe-area-inset-top)); left: 50%; display: flex; align-items: center; gap: 10rpx; max-width: 620rpx; padding: 15rpx 24rpx; border-radius: 999rpx; background: #fff; box-shadow: 0 12rpx 36rpx rgba(100,61,46,.18); color: var(--text); font-size: 23rpx; transform: translateX(-50%); }
.feedback-check { position: relative; width: 31rpx; height: 31rpx; border-radius: 50%; background: var(--green); }
.feedback-check::after { content: ''; position: absolute; left: 9rpx; top: 6rpx; width: 8rpx; height: 13rpx; border-right: 3rpx solid #fff; border-bottom: 3rpx solid #fff; transform: rotate(45deg); }
.meal-feedback.show { animation: feedback-in 1.45s ease both; }
.meal-section-heading { display: flex; justify-content: space-between; align-items: baseline; margin: 34rpx 2rpx 10rpx; }
.meal-section-heading > text:last-child { color: var(--muted); font-size: 21rpx; }
.meal-carousel-shell { position: relative; width: calc(100% + 56rpx); margin-left: -28rpx; padding: 0 0 12rpx; overflow: hidden; animation: meal-carousel-in .65s cubic-bezier(.16,1,.3,1) both; }
.meal-carousel { width: 100%; height: 416rpx; overflow: visible; }
.meal-slide { display: flex; align-items: center; justify-content: center; overflow: visible; }
.meal-button { --meal-accent: #b94733; --meal-soft: #fceae0; --meal-border: #ead8cf; position: relative; width: calc(100% - 20rpx); height: 366rpx; margin: 18rpx 10rpx 20rpx; padding: 24rpx 24rpx 20rpx; display: flex; flex-direction: column; align-items: stretch; overflow: hidden; box-sizing: border-box; border: 1rpx solid var(--meal-border); border-radius: 28rpx; background: var(--meal-soft); color: var(--text); line-height: 1.2; text-align: left; box-shadow: 0 12rpx 30rpx rgba(92,60,49,.07); opacity: .65; transform: scale(.88) translateY(16rpx); transition: opacity .42s ease, transform .52s cubic-bezier(.16,1,.3,1), box-shadow .42s ease, border-color .42s ease; }
.meal-breakfast, .meal-lunch, .meal-dinner { --meal-accent: #9a651f; --meal-soft: #fff9eb; --meal-border: #efdcae; }
.meal-button.is-active { z-index: 2; opacity: 1; transform: scale(1) translateY(0); box-shadow: 0 22rpx 52rpx rgba(92,60,49,.15); }
.meal-button:active { transform: scale(.97) translateY(2rpx); }
.meal-button.done { border-color: var(--meal-accent); }
.meal-button.disabled.is-active { opacity: .62; }
.meal-orbit { position: absolute; border: 1rpx solid var(--meal-border); border-radius: 50%; pointer-events: none; }
.meal-orbit-one { right: -82rpx; top: -105rpx; width: 270rpx; height: 270rpx; }
.meal-orbit-two { right: -34rpx; top: -58rpx; width: 174rpx; height: 174rpx; }
.meal-button.is-active .meal-orbit-one { animation: meal-orbit 1.1s cubic-bezier(.16,1,.3,1) both; }
.meal-card-top { position: relative; z-index: 1; width: 100%; display: grid; grid-template-columns: 66rpx 1fr auto; gap: 13rpx; align-items: center; }
.meal-icon { position: relative; width: 58rpx; height: 58rpx; transform: scale(1); transform-origin: left center; }
.meal-title-wrap { min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.meal-title { min-width: 0; color: var(--meal-accent); font-size: 34rpx; font-weight: 700; white-space: nowrap; transition: font-size .4s cubic-bezier(.16,1,.3,1), font-weight .3s ease; }
.meal-button.is-active .meal-title { font-size: 44rpx; font-weight: 800; }
.meal-status { padding: 6rpx 12rpx; border-radius: 999rpx; background: rgba(255,255,255,.72); color: var(--meal-accent); font-size: 18rpx; font-weight: 600; white-space: nowrap; }
.meal-status.completed { background: var(--meal-accent); color: #fff; }
.meal-caption { position: relative; z-index: 1; width: 100%; min-height: 80rpx; margin-top: 22rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; border: 1rpx solid var(--meal-border); border-radius: 18rpx; color: var(--muted); font-size: 22rpx; text-align: center; transition: background .3s ease, color .3s ease; }
.meal-cta { border: 0; background: var(--meal-accent); color: #fff; font-size: 28rpx; font-weight: 700; letter-spacing: 1rpx; box-shadow: 0 8rpx 18rpx rgba(73,53,47,.12); }
.meal-cta:active { opacity: .86; transform: scale(.985); }
.cta-arrow { width: 12rpx; height: 12rpx; border-top: 3rpx solid #fff; border-right: 3rpx solid #fff; transform: rotate(45deg); }
.meal-food-list { position: relative; z-index: 1; width: 100%; min-height: 96rpx; max-height: 96rpx; margin-top: 18rpx; padding: 10rpx 4rpx; overflow: hidden; border-top: 1rpx solid var(--meal-border); border-bottom: 1rpx solid var(--meal-border); }
.meal-food-summary { display: -webkit-box; width: 100%; overflow: hidden; color: var(--text); font-size: 22rpx; line-height: 1.55; overflow-wrap: break-word; font-variant-numeric: tabular-nums; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.meal-button.is-active .meal-food-summary { font-size: 27rpx; font-weight: 400; line-height: 1.4; }
.meal-macros { position: relative; z-index: 1; width: 100%; margin-top: auto; padding-top: 16rpx; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1rpx solid var(--meal-border); }
.meal-macros > view { min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.meal-macros > view > text:first-child { color: var(--meal-accent); font-size: 18rpx; font-weight: 600; }
.meal-macros > view > text:last-child { max-width: 100%; overflow: hidden; color: var(--text); font-size: 25rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; font-variant-numeric: tabular-nums; }
.meal-pagination { height: 20rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.meal-dot { width: 10rpx; height: 10rpx; border-radius: 999rpx; background: #ddcfc8; transition: width .35s cubic-bezier(.16,1,.3,1), background .3s ease; }
.meal-dot.active { width: 34rpx; background: #b94733; }
.raw-note { margin: 18rpx 12rpx 0; text-align: center; color: var(--muted); font-size: 20rpx; line-height: 1.55; }
.breakfast-sun { position: absolute; top: 0; right: 1rpx; width: 17rpx; height: 17rpx; border: 3rpx solid #d8942f; border-radius: 50%; }
.breakfast-sun::before, .breakfast-sun::after, .breakfast-sun > view { content: ''; position: absolute; left: 4rpx; top: -9rpx; width: 3rpx; height: 5rpx; border-radius: 4rpx; background: #d8942f; transform-origin: 1.5rpx 16rpx; }
.breakfast-sun::after { transform: rotate(90deg); }
.breakfast-sun > view { transform: rotate(45deg); }
.breakfast-cup { position: absolute; left: 5rpx; bottom: 5rpx; width: 32rpx; height: 26rpx; border: 4rpx solid #b94733; border-top-width: 3rpx; border-radius: 5rpx 5rpx 11rpx 11rpx; }
.breakfast-cup::after { content: ''; position: absolute; right: -13rpx; top: 4rpx; width: 10rpx; height: 12rpx; border: 3rpx solid #b94733; border-left: 0; border-radius: 0 9rpx 9rpx 0; }
.lunch-chopstick { position: absolute; z-index: 2; top: 0; width: 3rpx; height: 31rpx; border-radius: 4rpx; background: #9a5b45; transform-origin: top; }
.chopstick-left { left: 19rpx; transform: rotate(-12deg); }
.chopstick-right { left: 30rpx; transform: rotate(8deg); }
.lunch-rice { position: absolute; left: 9rpx; bottom: 19rpx; width: 35rpx; height: 17rpx; border: 4rpx solid #d8942f; border-bottom: 0; border-radius: 22rpx 22rpx 0 0; }
.lunch-bowl { position: absolute; left: 6rpx; bottom: 3rpx; width: 42rpx; height: 22rpx; border: 4rpx solid #b94733; border-top: 0; border-radius: 3rpx 3rpx 24rpx 24rpx; }
.lunch-bowl::before { content: ''; position: absolute; left: -3rpx; top: -5rpx; width: 40rpx; height: 4rpx; border-radius: 4rpx; background: #b94733; }
.dinner-moon { position: absolute; right: 1rpx; top: 0; width: 20rpx; height: 20rpx; border: 4rpx solid #83647d; border-left-color: transparent; border-radius: 50%; transform: rotate(16deg); }
.dinner-plate { position: absolute; left: 3rpx; bottom: 5rpx; width: 42rpx; height: 16rpx; border: 4rpx solid #b94733; border-radius: 50%; }
.dinner-plate::after { content: ''; position: absolute; left: 7rpx; right: 7rpx; bottom: -8rpx; height: 3rpx; border-radius: 4rpx; background: #b94733; }
.dinner-fork { position: absolute; left: 10rpx; top: 10rpx; width: 3rpx; height: 25rpx; border-radius: 4rpx; background: #d8942f; transform: rotate(-12deg); }
.dinner-fork::before { content: ''; position: absolute; left: -4rpx; top: 0; width: 11rpx; height: 8rpx; border-top: 3rpx solid #d8942f; border-left: 3rpx solid #d8942f; border-right: 3rpx solid #d8942f; }
@keyframes feedback-in { 0% { opacity: 0; transform: translate(-50%, -16rpx); } 16%,76% { opacity: 1; transform: translate(-50%, 0); } 100% { opacity: 0; transform: translate(-50%, -8rpx); } }
@keyframes meal-carousel-in { from { opacity: 0; transform: translateY(24rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes meal-orbit { from { opacity: .2; transform: rotate(-18deg) scale(.92); } to { opacity: 1; transform: rotate(0) scale(1); } }

<view class="page-shell home-page">
  <view class="home-header">
    <view><view class="greeting">今天吃什么</view><view class="section-caption">{{guestMode ? '先看看搭配方式，需要记录时再建立方案' : profile.nickname + '，吃对每一顿就很好'}}</view></view>
    <view class="today-badge">{{guestMode ? '方案预览' : completedCount + ' / ' + activeCount + ' 餐'}}</view>
  </view>

  <view wx:if="{{guestMode}}" class="guest-entry">
    <view><text>先体验，再建立方案</text><text>建立后即可按你的数据计算并保存记录</text></view>
    <button bindtap="startPersonalPlan">建立方案</button>
  </view>

  <view class="surface intake-table">
    <view class="intake-heading"><text>{{guestMode ? '营养示例' : '今日营养'}}</text><text>{{guestMode ? '建立方案后按身体数据计算' : '已完成 ' + intakeProgress + '%'}}</text></view>
    <view class="table-row table-header"><text></text><text class="macro-carbs">碳水</text><text class="macro-protein">蛋白质</text><text class="macro-fat">脂肪</text><text class="macro-calories">热量</text></view>
    <view class="table-row target-row"><text>{{guestMode ? '参考数值' : '今日可摄入'}}</text><view class="macro-carbs"><text>{{dailyTarget.carbs}}</text><text>g</text></view><view class="macro-protein"><text>{{dailyTarget.protein}}</text><text>g</text></view><view class="macro-fat"><text>{{dailyTarget.fat}}</text><text>g</text></view><view class="macro-calories"><text>{{dailyTarget.calories}}</text><text>kcal</text></view></view>
    <view wx:if="{{!guestMode}}" class="table-row consumed-row"><text>今日已摄入</text><view class="macro-carbs"><text>{{consumed.carbs}}</text><text>g</text></view><view class="macro-protein"><text>{{consumed.protein}}</text><text>g</text></view><view class="macro-fat"><text>{{consumed.fat}}</text><text>g</text></view><view class="macro-calories"><text>{{consumed.calories}}</text><text>kcal</text></view></view>
    <view wx:if="{{!guestMode}}" class="intake-progress"><view style="transform: scaleX({{intakeProgressScale}})"></view></view>
    <view wx:else class="guest-table-note">示例按默认身体数据计算，仅用于预览功能</view>
  </view>

  <view wx:if="{{celebrationText}}" class="meal-feedback {{celebrationClass}}"><view class="feedback-check"></view><text>{{celebrationText}}</text></view>

  <view class="meal-section-heading">
    <text class="section-title">今天的餐食</text>
    <text>左右滑动选择餐次</text>
  </view>
  <view class="meal-carousel-shell">
    <swiper
      class="meal-carousel"
      current="{{currentMealIndex}}"
      previous-margin="112rpx"
      next-margin="112rpx"
      duration="520"
      easing-function="easeOutCubic"
      bindchange="onMealSlideChange"
    >
      <swiper-item wx:for="{{meals}}" wx:key="type" class="meal-slide">
        <view
          class="meal-button meal-{{item.type}} {{item.type === activeMealType ? 'is-active' : ''}} {{item.done ? 'done' : ''}} {{item.disabled ? 'disabled' : ''}}"
          data-index="{{index}}"
          data-type="{{item.type}}"
          role="button"
          bindtap="selectMealCard"
        >
          <view class="meal-orbit meal-orbit-one"></view>
          <view class="meal-orbit meal-orbit-two"></view>
          <view class="meal-card-top">
            <view class="meal-icon breakfast-icon" wx:if="{{item.type === 'breakfast'}}"><view class="breakfast-sun"><view></view></view><view class="breakfast-cup"></view></view>
            <view class="meal-icon lunch-icon" wx:elif="{{item.type === 'lunch'}}"><view class="lunch-chopstick chopstick-left"></view><view class="lunch-chopstick chopstick-right"></view><view class="lunch-rice"></view><view class="lunch-bowl"></view></view>
            <view class="meal-icon dinner-icon" wx:else><view class="dinner-moon"></view><view class="dinner-plate"></view><view class="dinner-fork"></view></view>
            <view class="meal-title-wrap">
              <view class="meal-title">{{item.name}}</view>
            </view>
            <view class="meal-status {{item.done ? 'completed' : ''}}">{{item.done ? '完成' : item.disabled ? '停用' : '待选'}}</view>
          </view>
          <view wx:if="{{item.done}}" class="meal-food-list">
            <text class="meal-food-summary">{{item.foodSummary}}</text>
          </view>
          <view wx:else class="meal-caption {{!item.disabled && item.type === activeMealType ? 'meal-cta' : ''}}" data-index="{{index}}" data-type="{{item.type}}" catchtap="selectMealAction">
            <text>{{item.type === activeMealType ? item.caption : '滑到中间查看'}}</text>
            <view wx:if="{{!item.disabled && item.type === activeMealType}}" class="cta-arrow"></view>
          </view>
          <view wx:if="{{!item.disabled}}" class="meal-macros">
            <view><text>碳水</text><text>{{item.macro.carbs}}g</text></view>
            <view><text>蛋白质</text><text>{{item.macro.protein}}g</text></view>
            <view><text>脂肪</text><text>{{item.macro.fat}}g</text></view>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view class="meal-pagination">
      <view wx:for="{{meals}}" wx:key="type" class="meal-dot {{item.type === activeMealType ? 'active' : ''}}"></view>
    </view>
  </view>

  <view class="raw-note">需烹饪食材按烹饪前可食部分生重，即食食品按实际食用重量</view>
</view>

<intro-guide
  visible="{{mealGuideReady}}"
  step="{{1}}"
  total="{{6}}"
  title="先选择一餐"
  description="点击高亮的“选择食材”，进入这顿饭的食材搭配。"
  target-hint="点击高亮区域继续"
  target-style="{{mealGuideTargetStyle}}"
  tooltip-style="{{mealGuideTooltipStyle}}"
  placement="{{mealGuidePlacement}}"
  bind:skip="dismissMealGuide"
/>

<bottom-nav current="home" bind:weightsaved="refresh" />

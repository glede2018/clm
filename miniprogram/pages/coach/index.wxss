.partner-header { margin: 8rpx 2rpx 26rpx; }
.title { font-size: 42rpx; font-weight: 700; margin-bottom: 8rpx; }
.invite-box { padding: 16rpx 20rpx; }
.invite-button { width: 100%; min-width: 0; margin: 0; padding: 0 18rpx; border-radius: 18rpx; background: var(--surface-soft); color: var(--green-dark); font-size: 25rpx; line-height: 80rpx; }
.invite-button::after { border: 0; }
.bind-card { margin-top: 14rpx; padding: 20rpx; }
.bind-card .section-caption { display: block; margin-top: 8rpx; }
.code-row { width: 100%; min-width: 0; display: grid; grid-template-columns: 1fr 170rpx; align-items: center; gap: 12rpx; margin-top: 16rpx; }
.code-row input { width: 100%; min-width: 0; height: 82rpx; padding: 0 18rpx; border-radius: 18rpx; background: var(--page); text-transform: uppercase; letter-spacing: 3rpx; font-size: 28rpx; }
.code-row button { flex: 0 0 170rpx; width: 170rpx; min-width: 0; height: 82rpx; margin: 0; padding: 0; border-radius: 18rpx; background: var(--green); color: var(--surface); font-size: 25rpx; line-height: 82rpx; }
.code-row button::after { border: 0; }
.privacy-note { margin: 14rpx 2rpx; color: var(--muted); font-size: 21rpx; line-height: 1.5; }
.partner-heading { display: flex; justify-content: space-between; margin: 12rpx 2rpx; }
.partner-heading text:first-child { font-size: 30rpx; font-weight: 600; }
.partner-heading text:last-child { color: var(--muted); }
.partner-list { display: flex; flex-direction: column; gap: 14rpx; }
.partner-row { padding: 18rpx; display: grid; grid-template-columns: 64rpx minmax(0,1fr) auto; gap: 12rpx; align-items: center; border: 1rpx solid var(--line); box-shadow: none; margin-bottom: 12rpx; }
.partner-avatar { width: 70rpx; height: 70rpx; border-radius: 50%; display: grid; place-items: center; background: var(--green); color: var(--surface); }
.partner-copy { display: flex; flex-direction: column; gap: 7rpx; min-width: 0; overflow-wrap: anywhere; }
.partner-copy text:first-child { font-weight: 600; }
.partner-copy text:last-child { color: var(--muted); font-size: 21rpx; }
.partner-actions { display: flex; align-items: center; gap: 4rpx; }
.partner-weight { font-size: 28rpx; font-weight: 600; }
.partner-weight text { margin-left: 3rpx; color: var(--muted); font-size: 18rpx; }
.partner-actions button { margin: 0; padding: 0 12rpx; background: transparent; color: var(--coral); font-size: 22rpx; line-height: 80rpx; }
.partner-actions button::after { border: 0; }
.empty-partners { padding: 70rpx 30rpx; text-align: center; color: var(--muted); }
.invite-mask { position: fixed; z-index: 1200; inset: 0; padding: 40rpx; display: flex; align-items: center; justify-content: center; background: rgba(67, 39, 31, .48); animation: mask-fade .2s ease both; }
.invite-dialog { position: relative; width: 100%; max-width: 610rpx; padding: 42rpx 32rpx 30rpx; border-radius: 28rpx; background: var(--surface); text-align: center; box-shadow: 0 24rpx 70rpx rgba(91,48,36,.22); animation: dialog-pop .3s cubic-bezier(.16,1,.3,1) both; }
.dialog-close { position: absolute; top: 15rpx; right: 17rpx; width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--muted); font-size: 42rpx; line-height: 1; }
.dialog-title { font-size: 34rpx; font-weight: 700; }
.dialog-caption { margin-top: 10rpx; color: var(--muted); font-size: 23rpx; }
.invite-code { margin: 34rpx 0; padding: 25rpx 18rpx; border: 2rpx dashed var(--green); border-radius: 20rpx; background: var(--surface-soft); color: var(--green-dark); font-size: 54rpx; font-weight: 750; letter-spacing: 12rpx; }
.copy-button { margin: 0; border-radius: 18rpx; background: var(--green); color: var(--surface); font-size: 27rpx; line-height: 82rpx; }
.copy-button::after { border: 0; }
@keyframes dialog-pop { from { opacity: 0; transform: scale(.96) translateY(14rpx); } to { opacity: 1; transform: scale(1) translateY(0); } }
@keyframes mask-fade { from { opacity: 0; } to { opacity: 1; } }

.code-row button, .copy-button, .partner-avatar { color: var(--on-accent); }

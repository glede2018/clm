<view class="page-shell screen-page partner-page">
  <view class="partner-header">
    <view class="title">我的伙伴</view>
    <view class="section-caption">与其他用户双向绑定，互相查看已授权的饮食和体重记录</view>
  </view>

  <view class="surface invite-box">
    <button class="invite-button" bindtap="createInvite" loading="{{inviteLoading}}" disabled="{{inviteLoading}}">生成邀请码</button>
  </view>

  <view class="surface bind-card">
    <view class="section-title">输入对方的邀请码</view>
    <view class="section-caption">绑定成功后，双方都会出现在彼此的伙伴列表</view>
    <view class="code-row">
      <input maxlength="6" placeholder="例如 A8K2M6" value="{{bindCode}}" bindinput="onCodeInput" />
      <button bindtap="bindPartner" loading="{{bindLoading}}" disabled="{{bindLoading}}">确认绑定</button>
    </view>
  </view>

  <view class="privacy-note">绑定是双向授权。双方可以查看对方确认记录的餐食克重和体重趋势，但不能修改对方记录，任意一方都可解除。</view>

  <view class="partner-heading"><text>已绑定用户</text><text>{{partners.length}} 人</text></view>
  <scroll-view class="content-scroll partner-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{partners.length}}" class="partner-list">
      <view wx:for="{{partners}}" wx:key="openId" class="surface partner-row" data-id="{{item.openId}}" bindtap="openPartner">
        <view class="partner-avatar">{{item.initial}}</view>
        <view class="partner-copy"><text>{{item.nickname}}</text><text>今日 {{item.todayMeals}}/{{item.targetMeals}} 餐</text></view>
        <view class="partner-actions">
          <view class="partner-weight">{{item.latestWeight || '--'}}<text>kg</text></view>
          <button data-id="{{item.openId}}" catchtap="unbindPartner">解除</button>
        </view>
      </view>
    </view>
    <view wx:else class="surface empty-partners">还没有绑定用户，可以生成邀请码分享给朋友</view>
</scroll-view>

  </view>

<view wx:if="{{inviteVisible}}" class="invite-mask" bindtap="closeInvite">
  <view class="invite-dialog" catchtap="noop">
    <view class="dialog-close" bindtap="closeInvite">×</view>
    <view class="dialog-title">绑定邀请码</view>
    <view class="dialog-caption">将邀请码发送给需要绑定的用户</view>
    <view class="invite-code">{{inviteCode}}</view>
    <button class="copy-button" bindtap="copyInvite">复制邀请码</button>
  </view>
</view>
<bottom-nav current="partners" />

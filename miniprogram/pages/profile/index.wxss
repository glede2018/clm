.profile-page { padding-bottom: calc(152rpx + env(safe-area-inset-bottom)); }
.heading { display: flex; justify-content: space-between; align-items: flex-start; margin: 8rpx 0 28rpx; gap: 20rpx; }
.title { font-size: 42rpx; font-weight: 700; margin-bottom: 8rpx; }
.form-card { padding: 8rpx 26rpx; }
.field-row { min-height: 96rpx; display: flex; align-items: center; border-bottom: 1rpx solid var(--line); gap: 14rpx; }
.field-row:last-child { border-bottom: 0; }
.field-label { flex: 0 0 126rpx; width: 126rpx; color: var(--muted); }
.field-input { flex: 1; text-align: right; }
.nickname-plain { flex: 1; min-width: 0; padding: 0; color: var(--text); font-weight: 600; text-align: left; background: transparent; }
.number-input { width: 150rpx; text-align: left; font-size: 32rpx; font-weight: 600; }
.date-picker { color: var(--green-dark); }
.choice-row { min-width: 0; margin-left: 0; margin-right: auto; display: flex; gap: 12rpx; }
.choice { flex: 0 0 108rpx; width: 108rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: var(--page); color: var(--muted); font-size: 26rpx; }
.exercise-option::after, .meal-count::after { border: 0; }
.choice.active { background: var(--green); color: #fff; }
.block-title { margin-top: 34rpx; font-size: 30rpx; font-weight: 600; }
.block-caption { margin: 6rpx 0 18rpx; }
.exercise-grid { width: 100%; display: flex; align-items: stretch; justify-content: space-between; }
.exercise-option { flex: 0 0 24%; width: 24%; max-width: 24%; min-width: 0; min-height: 100rpx; margin: 0; padding: 10rpx 3rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; box-sizing: border-box; border: 1rpx solid var(--line); box-shadow: none; color: var(--text); line-height: 1.35; text-align: center; font-size: 27rpx; }
.exercise-option text { display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.exercise-option text:last-child { color: var(--muted); font-size: 23rpx; }
.exercise-option.active { border-color: var(--green); background: var(--surface-soft); }
.meal-count-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 18rpx; }
.meal-count { margin: 0; padding: 24rpx 18rpx; display: flex; flex-direction: column; align-items: flex-start; border: 1rpx solid var(--line); box-shadow: none; color: var(--text); line-height: 1.7; font-size: 28rpx; }
.meal-count text:last-child { color: var(--muted); font-size: 21rpx; text-align: left; }
.meal-count.active { border-color: var(--green); background: var(--surface-soft); }
.target-card { margin-top: 30rpx; padding: 28rpx; }
.target-card > view:first-child { display: flex; justify-content: space-between; align-items: center; }
.target-kcal { color: var(--coral); font-weight: 600; }
.macro-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 24rpx; }
.macro-row view { padding: 18rpx 12rpx; border-radius: 18rpx; background: var(--page); display: flex; flex-direction: column; gap: 6rpx; color: var(--muted); font-size: 22rpx; }
.macro-row .strong { color: var(--text); font-size: 31rpx; font-weight: 600; }
.source-note { margin-top: 22rpx; padding-top: 20rpx; display: flex; align-items: flex-start; gap: 12rpx; border-top: 1rpx solid var(--line); color: var(--muted); font-size: 21rpx; line-height: 1.55; }
.source-note-icon { flex: 0 0 30rpx; width: 30rpx; height: 30rpx; margin-top: 1rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--line); border-radius: 50%; color: var(--green-dark); font-size: 18rpx; font-weight: 700; line-height: 1; }
.source-note-text { flex: 1; min-width: 0; }
.save-button { margin-top: 30rpx; }
.safe-note { margin: 22rpx 8rpx 0; }

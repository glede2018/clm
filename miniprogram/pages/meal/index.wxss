.meal-page { padding-bottom: calc(116rpx + env(safe-area-inset-bottom)); }
.meal-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 18rpx; margin: 8rpx 2rpx 32rpx; }
.title { font-size: 42rpx; font-weight: 700; margin-bottom: 8rpx; }
.raw-pill { padding: 9rpx 17rpx; border-radius: 999rpx; background: var(--surface-soft); color: var(--muted); font-size: 22rpx; white-space: nowrap; }
.food-section { margin-bottom: 22rpx; animation: none; }
.food-section:nth-child(3) { animation-delay: .04s; }
.food-section:nth-child(4) { animation-delay: .08s; }
.food-section:nth-child(5) { animation-delay: .12s; }
.food-section:nth-child(6) { animation-delay: .16s; }
.section-heading { display: flex; justify-content: space-between; align-items: center; margin: 0 3rpx 14rpx; }
.section-heading text:first-child { font-weight: 600; font-size: 30rpx; }
.section-heading text:last-child { color: var(--muted); font-size: 22rpx; }
.food-grid { display: flex; flex-wrap: wrap; gap: 10rpx; align-items: center; }
.food-choice { flex: 0 0 auto; width: auto; max-width: 100%; min-height: 80rpx; padding: 0 20rpx; border: 2rpx solid var(--line); border-radius: 16rpx; background: var(--surface); color: var(--text); font-size: 25rpx; line-height: 76rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; white-space: nowrap; }
.food-choice.selected { border-color: var(--green); background: var(--surface-soft); animation: food-select .22s cubic-bezier(.16,1,.3,1) both; }
.selected-check { color: var(--green-dark); font-weight: 700; }
.generate-button { margin-top: 16rpx; width: 100%; }
.center-note { text-align: center; margin: 12rpx 0 0; font-size: 20rpx; line-height: 1.5; }
.result-mask { position: fixed; z-index: 1300; inset: 0; background: rgba(48,37,34,.5); display: flex; align-items: flex-end; }
.result-sheet { width: 100%; max-height: 88vh; overflow-y: auto; background: var(--page); border-radius: 32rpx 32rpx 0 0; padding: 18rpx 30rpx calc(142rpx + env(safe-area-inset-bottom)); animation: sheet-up .35s cubic-bezier(.16,1,.3,1) both; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.sheet-handle { width: 80rpx; height: 8rpx; border-radius: 99rpx; background: var(--line); margin: 0 auto 25rpx; }
.result-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 20rpx; }
.result-heading > view:first-child { display: flex; flex-direction: column; gap: 6rpx; }
.result-heading > view:first-child text:first-child { font-size: 38rpx; font-weight: 700; }
.result-heading > view:first-child text:last-child { color: var(--muted); font-size: 22rpx; }
.accuracy { padding: 9rpx 14rpx; border-radius: 999rpx; background: var(--surface-soft); color: var(--green-dark); font-size: 22rpx; }
.portion-list { margin-top: 24rpx; padding: 0 24rpx; border-radius: 26rpx; background: var(--surface); }
.portion-row { min-height: 82rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--line); }
.portion-row:last-child { border-bottom: 0; }
.portion-name { min-width: 0; padding: 13rpx 18rpx 13rpx 0; display: flex; flex-direction: column; gap: 4rpx; }
.portion-name > text:first-child { font-size: 27rpx; font-weight: 600; }
.portion-name > text:last-child { color: var(--muted); font-size: 20rpx; line-height: 1.4; }
.portion-weight { flex: 0 0 auto; }
.portion-weight > text:first-child { font-size: 36rpx; font-weight: 700; }
.portion-weight > text:last-child { margin-left: 5rpx; color: var(--muted); }
.macro-summary { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 20rpx; padding: 18rpx 8rpx; border-radius: 20rpx; background: var(--surface-soft); }
.macro-summary view { display: flex; flex-direction: column; align-items: center; gap: 6rpx; border-right: 1rpx solid var(--line); }
.macro-summary view:last-child { border-right: 0; }
.macro-summary text:first-child { color: var(--muted); font-size: 20rpx; }
.macro-summary text:last-child { font-size: 23rpx; font-weight: 600; }
.confirm-button { margin-top: 24rpx; }
.revise-button { margin-top: 14rpx; }
@keyframes food-select { from { transform: scale(.92); } to { transform: scale(1); } }
@keyframes sheet-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes section-rise { from { opacity: 0; transform: translateY(10rpx); } to { opacity: 1; transform: translateY(0); } }
